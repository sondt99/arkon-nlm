# ============================================================
# Arkon — Docker Compose environment
# cp .env.docker.example .env.docker
# ============================================================

# --- PostgreSQL ---
# POSTGRES_* are used by the postgres container; DATABASE_URL must match them
POSTGRES_USER=arkon
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=arkon
# DATABASE_URL is composed by docker-compose.yml from POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB, so the password lives in exactly one place. Uncomment and set it only to
# point at a database compose does not run — managed Postgres, a connection pooler, or a
# host needing sslmode. An explicit value here still wins.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# --- Auth (JWT) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-string

# --- Default Admin Account ---
DEFAULT_ADMIN_EMAIL=admin@arkon.local
DEFAULT_ADMIN_PASSWORD=change-me-admin-password

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
# MINIO_PUBLIC_ENDPOINT: browser-accessible address used in presigned file URLs.
#
# With nginx (default setup) — nginx routes /arkon-files/ to MinIO internally,
# so NO port is needed. Just set the public hostname/IP:
#   HTTP  (IP or domain without HTTPS):  MINIO_PUBLIC_ENDPOINT=192.168.1.100
#   HTTPS (domain with SSL):             MINIO_PUBLIC_ENDPOINT=yourdomain.com
#
# Without nginx — set to the host that exposes MinIO port 9002:
#   MINIO_PUBLIC_ENDPOINT=192.168.1.100:9002
#
# IMPORTANT: Must match the path prefix in nginx/nginx.conf (/arkon-files/).
# If you change MINIO_BUCKET, update nginx.conf accordingly.
MINIO_PUBLIC_ENDPOINT=your-server-ip-or-domain
# Both MinIO credentials are rejected at startup if left at a known default —
# "minioadmin" is refused for the access key, so this needs a real value too.
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=arkon-files
# MINIO_SECURE: set to true when the site is served over HTTPS so presigned
# URLs use https://. Keep false for plain HTTP / IP:port access.
MINIO_SECURE=false
# Lifetime of a presigned download URL, in MINUTES. After issuance the URL is an
# unauthenticated bearer capability that outlives permission revocation and
# account deletion, so keep it short.
MINIO_PRESIGN_EXPIRY_MINUTES=30

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Must be non-empty and must match what the redis container is started with
# (docker-compose.yml's --requirepass) — an empty value here while the
# container falls back to a non-empty default breaks arq authentication.
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=3600

# --- Upload limits ---
# MAX_REQUEST_BODY_MB is enforced by middleware ahead of every route (413), and must
# stay at or above the largest per-route cap or Settings refuses to construct.
# nginx's client_max_body_size sits just above it at 260m.
MAX_UPLOAD_MB=100
MAX_ZIP_UPLOAD_MB=200
MAX_REQUEST_BODY_MB=256
# Caps on the *decompressed* archive — the upload cap bounds compressed bytes only.
MAX_ZIP_ENTRIES=50
MAX_ZIP_MEMBER_MB=50
MAX_ZIP_TOTAL_MB=500
# Cumulative budget for one skill contribution's workspace, plus the cap on the
# JSON text-write path (which no multipart guard covers).
MAX_CONTRIBUTION_TEXT_KB=1024
MAX_CONTRIBUTION_TOTAL_MB=25
MAX_CONTRIBUTION_FILES=200

# --- MCP tokens ---
# Lifetime of a generated ark_ bearer token. Expired tokens are rejected.
MCP_TOKEN_EXPIRY_DAYS=90

# --- MRP document accuracy profile ---
# Skip human plan review and write pages straight from the compilation plan.
# Only for a pipeline whose inputs you already trust.
MRP_AUTO_APPROVE_PLAN=false
# Use a stable explicit model for structured extraction/writing. Leave empty to
# use the Admin Portal LLM model (router aliases fall back to an explicit model).
MRP_INGESTION_MODEL_ID=
MRP_CHUNK_TARGET_CHARS=12000
MRP_CHUNK_OVERLAP_CHARS=1000
MRP_MAP_MAX_CONCURRENCY=6
MRP_EXTRACT_TIMEOUT=120
MRP_ENTITY_MERGE_THRESHOLD=0.90
MRP_ENTITY_AMBIGUOUS_THRESHOLD=0.75
MRP_KB_UPDATE_THRESHOLD=0.82
MRP_KB_MAYBE_THRESHOLD=0.48
MRP_KB_MIN_SEMANTIC_SIMILARITY=0.72
MRP_KB_MIN_LEXICAL_SIMILARITY=0.72
MRP_WRITER_MAX_CONCURRENCY=4
MRP_WRITER_TIMEOUT=300
MRP_WRITER_MAX_ATTEMPTS=3
MRP_VERIFY_CONFLICT_THRESHOLD=0.80
MRP_VERIFY_MIN_MENTIONS=3
MRP_MERGE_MIN_BODY_RATIO=0.70
MRP_MERGE_TIMEOUT=120

# --- Chatbot latency profile ---
CHAT_RAG_TOP_K=4
CHAT_LINKED_PAGES_LIMIT=2
CHAT_CONTEXT_CHARS_PER_PAGE=2500
CHAT_HISTORY_MESSAGES=6
CHAT_GENERATION_TIMEOUT=240
CHAT_MIN_DETAILED_ANSWER_CHARS=1800
CHAT_EXPAND_SHORT_ANSWERS=true

# --- Omniroute (OpenAI-compatible LLM proxy) ---
# If all three are set and Settings has no LLM provider yet, they become the LLM slot.
# A value saved in Admin Settings always wins.
# OMNIROUTE_API_KEY=
# OMNIROUTE_BASE_URL=https://ai.nosiaht.com/v1
# OMNIROUTE_MODEL=nosiaht

# --- NotebookLM Integration ---
# Path inside the container where notebooklm-py stores Google session cookies.
# Mount this directory as a volume so sessions survive container restarts.
# Leave empty to use the OS default (~/.config/notebooklm on Linux).
NOTEBOOKLM_STORAGE_PATH=/data/notebooklm-session

# --- Nginx reverse proxy ---
# Port exposed on the host for the nginx container (default: 3119).
# For domain deployment set to 80 so your server's nginx/Caddy can forward to it.
NGINX_PORT=3119

# --- CORS ---
# Leave empty for the default nginx-fronted setup (frontend + API are served
# same-origin through nginx, so no CORS header is needed). Only set this if
# the API is called directly from a browser on a different origin than the
# frontend — e.g. https://arkon.yourcompany.com. Do NOT set to "*": this API
# sends credentials, and "*" + credentials lets any website call it using a
# logged-in user's token.
CORS_ORIGINS=

# --- Schema migrations ---
# Migrations run in the one-shot `migrate` service, not in api/worker/worker_skills.
# `docker compose up -d` still applies them automatically before the API starts.
#
# migrate.sh REFUSES to apply a pending revision whose upgrade() drops a table or column, or
# issues DELETE/TRUNCATE. It prints the revision, file and line and exits non-zero without
# touching the database. Set this to 1 — ideally on the command line for that one run, not
# here — to apply it anyway, after taking a backup:
#
#   docker exec arkon_postgres pg_dump -U arkon -d arkon -Fc > arkon-$(date +%F).dump
#   ALLOW_DESTRUCTIVE_MIGRATIONS=1 docker compose --env-file .env.docker run --rm migrate
#
# Leaving it set to 1 permanently disables the only thing standing between a bad migration
# and your data.
# ALLOW_DESTRUCTIVE_MIGRATIONS=0

# --- Resource limits (optional) ---
# Upper bounds per container; defaults are generous for a small/mid deployment.
# Lower these if running on a memory-constrained host.
# POSTGRES_MEM_LIMIT=1g
# POSTGRES_CPUS=1.0
# REDIS_MEM_LIMIT=512m
# REDIS_CPUS=0.5
# MINIO_MEM_LIMIT=1g
# MINIO_CPUS=1.0
# API_MEM_LIMIT=2g
# API_CPUS=2.0
# WORKER_MEM_LIMIT=3g
# WORKER_CPUS=2.0
# WORKER_SKILLS_MEM_LIMIT=1g
# WORKER_SKILLS_CPUS=1.0
# MIGRATE_MEM_LIMIT=1g
# MIGRATE_CPUS=1.0
# FRONTEND_MEM_LIMIT=1g
# FRONTEND_CPUS=1.0
# NGINX_MEM_LIMIT=256m
# NGINX_CPUS=0.5

# --- Frontend ---
# Leave EMPTY to use Next.js rewrite proxy (/api/* → api container).
# Only set this if the frontend and API are on different domains/ports.
# WARNING: Setting to http://localhost:5055 breaks access from other machines.
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://api:5055
