# ============================================================
# Arkon — Docker Compose environment
# cp .env.docker.example .env.docker
# ============================================================

# --- PostgreSQL ---
# POSTGRES_* are used by the postgres container; DATABASE_URL must match them
POSTGRES_USER=arkon
POSTGRES_PASSWORD=arkon_secret
POSTGRES_DB=arkon
DATABASE_URL=postgresql+asyncpg://arkon:arkon_secret@postgres:5432/arkon

# --- Auth (JWT) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-string

# --- Default Admin Account ---
DEFAULT_ADMIN_EMAIL=admin@arkon.local
DEFAULT_ADMIN_PASSWORD=admin123

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
# MINIO_PUBLIC_ENDPOINT: browser-accessible address used in presigned file URLs.
#
# With nginx (default setup) — nginx routes /arkon-files/ to MinIO internally,
# so NO port is needed. Just set the public hostname/IP:
#   HTTP  (IP or domain without HTTPS):  MINIO_PUBLIC_ENDPOINT=192.168.1.100
#   HTTPS (domain with SSL):             MINIO_PUBLIC_ENDPOINT=yourdomain.com
#
# Without nginx — set to the host that exposes MinIO port 9002:
#   MINIO_PUBLIC_ENDPOINT=192.168.1.100:9002
#
# IMPORTANT: Must match the path prefix in nginx/nginx.conf (/arkon-files/).
# If you change MINIO_BUCKET, update nginx.conf accordingly.
MINIO_PUBLIC_ENDPOINT=your-server-ip-or-domain
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=arkon-files
# MINIO_SECURE: set to true when the site is served over HTTPS so presigned
# URLs use https://. Keep false for plain HTTP / IP:port access.
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=3600

# --- MRP document accuracy profile ---
# Use a stable explicit model for structured extraction/writing. Leave empty to
# use the Admin Portal LLM model (router aliases fall back to an explicit model).
MRP_INGESTION_MODEL_ID=
MRP_CHUNK_TARGET_CHARS=12000
MRP_CHUNK_OVERLAP_CHARS=1000
MRP_MAP_MAX_CONCURRENCY=6
MRP_EXTRACT_TIMEOUT=120
MRP_ENTITY_MERGE_THRESHOLD=0.90
MRP_ENTITY_AMBIGUOUS_THRESHOLD=0.75
MRP_KB_UPDATE_THRESHOLD=0.82
MRP_KB_MAYBE_THRESHOLD=0.48
MRP_KB_MIN_SEMANTIC_SIMILARITY=0.72
MRP_KB_MIN_LEXICAL_SIMILARITY=0.72
MRP_WRITER_MAX_CONCURRENCY=4
MRP_WRITER_TIMEOUT=300
MRP_WRITER_MAX_ATTEMPTS=3
MRP_VERIFY_CONFLICT_THRESHOLD=0.80
MRP_VERIFY_MIN_MENTIONS=3
MRP_MERGE_MIN_BODY_RATIO=0.70
MRP_MERGE_TIMEOUT=120

# --- Chatbot latency profile ---
CHAT_RAG_TOP_K=4
CHAT_LINKED_PAGES_LIMIT=2
CHAT_CONTEXT_CHARS_PER_PAGE=2500
CHAT_HISTORY_MESSAGES=6
CHAT_GENERATION_TIMEOUT=240
CHAT_MIN_DETAILED_ANSWER_CHARS=1800
CHAT_EXPAND_SHORT_ANSWERS=true

# --- NotebookLM Integration ---
# Path inside the container where notebooklm-py stores Google session cookies.
# Mount this directory as a volume so sessions survive container restarts.
# Leave empty to use the OS default (~/.config/notebooklm on Linux).
NOTEBOOKLM_STORAGE_PATH=/data/notebooklm-session

# --- Nginx reverse proxy ---
# Port exposed on the host for the nginx container (default: 3119).
# For domain deployment set to 80 so your server's nginx/Caddy can forward to it.
NGINX_PORT=3119

# --- CORS ---
# Production: set to your actual domain, e.g. https://arkon.yourcompany.com
CORS_ORIGINS=*

# --- Frontend ---
# Leave EMPTY to use Next.js rewrite proxy (/api/* → api container).
# Only set this if the frontend and API are on different domains/ports.
# WARNING: Setting to http://localhost:5055 breaks access from other machines.
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://api:5055
