# ============================================================
# Arkon — Local development environment
# cp .env.local.example .env.local
# Requires: PostgreSQL, Redis, MinIO running on localhost
# ============================================================
#
# READ THIS FIRST. Every credential below is a known-weak value that Settings
# rejects at construction time, and CORS_ORIGINS=* raises at API startup. That is
# deliberate — but it means this file only works because of the two escape
# hatches at the bottom. They are the first thing to set, not the last: alembic
# imports app.config, so `alembic upgrade head` fails before touching the DB
# without them.
#
# For anything reachable by anyone else, use real secrets and delete the hatches.

# --- Development escape hatches ---
# ARKON_ALLOW_DEFAULT_SECRET skips the ENTIRE weak-credential validator, not just
# SECRET_KEY. ARKON_ALLOW_CORS_WILDCARD permits CORS_ORIGINS=* with credentials.
# Both are real Settings fields, so they work from this file.
ARKON_ALLOW_DEFAULT_SECRET=1
ARKON_ALLOW_CORS_WILDCARD=1

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://arkon:arkon_secret@localhost:5432/arkon

# --- Auth (JWT) ---
SECRET_KEY=change-me-to-a-random-secret-string

# --- Default Admin Account ---
DEFAULT_ADMIN_EMAIL=admin@arkon.local
DEFAULT_ADMIN_PASSWORD=admin123

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=arkon-files
MINIO_SECURE=false
# Lifetime of a presigned download URL, in MINUTES (not hours).
MINIO_PRESIGN_EXPIRY_MINUTES=30

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty is a rejected value, and only passes here because of the escape hatch
# above. The documented local Redis is started without --requirepass.
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=600

# --- MRP Pipeline ---
# Skip human plan review and write pages straight from the compilation plan.
MRP_AUTO_APPROVE_PLAN=false

# --- Upload limits ---
# Defaults shown; MAX_REQUEST_BODY_MB is enforced by middleware on every route
# and must stay at or above the largest per-route cap.
MAX_UPLOAD_MB=100
MAX_ZIP_UPLOAD_MB=200
MAX_REQUEST_BODY_MB=256

# --- CORS ---
# Raises at startup unless ARKON_ALLOW_CORS_WILDCARD is set (see top of file).
CORS_ORIGINS=*

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5055
